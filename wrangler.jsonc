// Cloudflare-Konfiguration für EricMotors (Workers Free Plan).
// Ein Worker liefert die SPA als Static Assets aus und beantwortet nur `/api/*` und `/v/*`.
// Keine Secrets in diese Datei! Secrets: `npx wrangler secret put <NAME>` bzw. Dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ericmotors",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Nur diese Pfade rufen den Worker auf; alles andere ist kostenloser Static-Asset-Traffic.
    "run_worker_first": ["/api/*", "/v/*"],
  },

  "routes": [{ "pattern": "car.scheber.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,

  "observability": { "enabled": true },

  // ---------- Produktion ----------
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_ORIGIN": "https://car.scheber.com",
    "MAX_DESIGNS_PER_USER": "50",
    "MAX_DESIGN_BYTES": "524288",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ericmotors-prod",
      "database_id": "99fe598e-66f8-4dd3-afbc-2050bcedcbcc",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "ericmotors-prod" }],
  "ratelimits": [
    // Schreibende Endpoints: 30 Requests pro 60 s und Nutzer (approximativ pro Standort).
    { "name": "WRITE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    // Login/Registrierung: 10 Versuche pro 60 s und IP (Schutz gegen Passwort-Raten).
    { "name": "AUTH_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
  ],

  // ---------- Previews (jeder Nicht-main-Branch) ----------
  // Getrennte Datenbank und getrennter Bucket, damit Previews nie Produktionsdaten verändern.
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview",
      "PUBLIC_ORIGIN": "https://car.scheber.com",
      "MAX_DESIGNS_PER_USER": "50",
      "MAX_DESIGN_BYTES": "524288",
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "ericmotors-preview",
        "database_id": "9ec9909e-46bb-4b18-8b9c-86afeeade50f",
      },
    ],
    "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "ericmotors-preview" }],
    "ratelimits": [
      { "name": "WRITE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
      { "name": "AUTH_LIMITER", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    ],
  },
}

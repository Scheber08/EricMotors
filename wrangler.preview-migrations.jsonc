// Nur für `wrangler d1 migrations apply PREVIEW_DB --remote --config wrangler.preview-migrations.jsonc`.
// Muss auf dieselbe Datenbank zeigen wie `previews.d1_databases` in `wrangler.jsonc`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ericmotors-preview-migrations",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "PREVIEW_DB",
      "database_name": "ericmotors-preview",
      // Gleiche ID wie in wrangler.jsonc › previews.d1_databases.
      "database_id": "9ec9909e-46bb-4b18-8b9c-86afeeade50f",
      "migrations_dir": "migrations",
    },
  ],
}

// Nur für `wrangler d1 migrations apply PREVIEW_DB --remote --config wrangler.preview-migrations.jsonc`.
// Muss auf dieselbe Datenbank zeigen wie `previews.d1_databases` in `wrangler.jsonc`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ericmotors-preview-migrations",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "PREVIEW_DB",
      "database_name": "ericmotors-preview",
      // TODO(setup): gleiche ID wie in wrangler.jsonc › previews.d1_databases.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}

{
  "name": "@ericmotors/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('../web/dist',{recursive:true})\" && wrangler dev --config ../../wrangler.jsonc --port 8787",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=../../.wrangler/smoke.mjs --log-level=warning && node ../../.wrangler/smoke.mjs"
  },
  "dependencies": {
    "@ericmotors/schema": "*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "esbuild": "^0.28.2"
  }
}
